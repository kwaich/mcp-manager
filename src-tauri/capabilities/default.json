{
  "identifier": "default",
  "description": "Capability for the main window — grants read/write access to Claude and Cursor config files",
  "windows": ["main"],
  "permissions": [
    "core:path:default",
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "core:image:default",
    "core:resources:default",
    "core:menu:default",
    "core:tray:default",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "$HOME/Library/Application Support/Claude/**" },
        { "path": "$HOME/Library/Application Support/Cursor/**" },
        { "path": "$HOME/AppData/Roaming/Claude/**" },
        { "path": "$HOME/AppData/Roaming/Cursor/**" },
        { "path": "$HOME/.config/Claude/**" },
        { "path": "$HOME/.config/Cursor/**" },
        { "path": "$APPDATA/**" },
        { "path": "$RESOURCE/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "$HOME/Library/Application Support/Claude/**" },
        { "path": "$HOME/Library/Application Support/Cursor/**" },
        { "path": "$HOME/AppData/Roaming/Claude/**" },
        { "path": "$HOME/AppData/Roaming/Cursor/**" },
        { "path": "$HOME/.config/Claude/**" },
        { "path": "$HOME/.config/Cursor/**" },
        { "path": "$APPDATA/**" }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "$APPDATA" },
        { "path": "$APPDATA/**" }
      ]
    },
    "fs:allow-exists"
  ]
}
